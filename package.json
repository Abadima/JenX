{
  "name": "jenx",
  "version": "1.0.0",
  "description": "Community add-on for the Jena ecosystem",
  "homepage": "https://github.com/Abadima/JenX#readme",
  "bugs": {
    "url": "https://github.com/Abadima/JenX/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abadima/JenX.git"
  },
  "author": "Abadima",
  "license": "Apache-2.0",
  "type": "module",
  "main": "build/bot.js",
  "scripts": {
    "build": "node build.js",
    "build:node": "node build.js",
    "build:bun": "bun build.js",
    "build:watch": "node build.js --watch",
    "build:watch:bun": "bun build.js --watch",
    "start": "node .",
    "start:node": "node .",
    "start:bun": "bun .",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "bun run typecheck && bun test tests && node --test .test-build/tests",
    "test:bun": "bun run typecheck && bun test tests",
    "test:node": "bun run typecheck && node --test .test-build/tests"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "logena": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  }
}